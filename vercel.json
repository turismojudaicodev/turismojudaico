{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "en.turismojudaico.com"
        }
      ],
      "destination": "/en/$1",
      "permanent": true
    },
    {
      "source": "/contenidos/(.*)",
      "destination": "https://turismojudaico.com/en"
    },
    {
      "source": "/paises/(.*)",
      "destination": "https://turismojudaico.com/en"
    },
    {
      "source": "/ciudades/(.*)",
      "destination": "https://turismojudaico.com/en"
    },
    {
      "source": "/contenidos/(.*)",
      "destination": "https://turismojudaico.com/en"
    },
    {
      "source": "/contenido/(.*)",
      "destination": "https://turismojudaico.com/en"
    },
    {
      "source": "/tour/(.*)",
      "destination": "https://turismojudaico.com/en"
    },
    {
      "source": "/test/(.*)",
      "destination": "https://turismojudaico.com/en"
    }
  ]
}
